# ==============================================================================
# Vidyadwaar Backend Configuration Template
# Copy this file to backend/.env and replace placeholders with your credentials.
# NEVER commit backend/.env to Git.
# ==============================================================================

# 1. Database Connection (Neon / Cloud PostgreSQL)
# Owner direct connection string (unpooled, SSL required on Neon).
# Used for running schema initialization:
DATABASE_URL=postgresql://neondb_owner:<OWNER_PASSWORD>@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Direct unpooled connection string (required on Vercel serverless):
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<OWNER_PASSWORD>@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Target database name (defaults to 'neondb' on Vercel/Neon):
APAAR_DB=neondb

# 2. Application Runtime Access Role (Restricted Non-Owner)
# Database role used by FastAPI for runtime queries with Row-Level Security:
APP_ROLE=vidya_app

# Password for the restricted application role (must match the role's password in PostgreSQL):
APP_DB_PASSWORD=<APP_ROLE_PASSWORD>

# Optional: Separate direct runtime connection URI for vidya_app:
# APP_DATABASE_URL=postgresql://vidya_app:<APP_ROLE_PASSWORD>@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. Environment & Prototype Flags
# Set to 'false' for production, 'true' for local prototype evaluation:
DEMO_MODE=true

# 4. Cryptographic Key Bundle (Vercel Serverless Read-Only Filesystem)
# Single-line JSON string containing symmetric and Ed25519 signing keys.
# Generate via: python tools/deploy_keys.py --out keys.json
# APAAR_KEYS_JSON={"k_enc":"...","signing":{...}}

# 5. Optional Integrations
# Gemini API Key for AI regulatory explanations:
# GEMINI_API_KEY=
