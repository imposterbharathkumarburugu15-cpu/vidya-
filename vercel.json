{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/{app,data,i18n}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/docs",
      "destination": "/api/index"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index"
    },
    {
      "source": "/status/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/dids/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|demo-data/|plugins/|v1/|healthz|docs|openapi.json|status/|dids/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
